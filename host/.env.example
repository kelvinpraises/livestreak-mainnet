# Arc mainnet template (5042). Runtime migration and deployment are still pending.
# Host runtime configuration. Copy to a private environment file; never commit values.
# Use dedicated database and storage resources for each environment.
LIVESTREAK_HOST_ID=livestreak-mainnet
LIVESTREAK_HOST_BASE_URL=https://YOUR_HOST_DOMAIN
LIVESTREAK_HOST_BIND_HOST=0.0.0.0
LIVESTREAK_HOST_BIND_PORT=8787
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=
# DATABASE_URL is an alternative remote connection URL; no local file fallback.

# Hosted EVM backend. Configure explicit deployed contract snapshots.
LIVESTREAK_AA_FROM_DEPLOY=0
LIVESTREAK_DEPLOY_SNAPSHOT=
LIVESTREAK_AA_CHAINS_FILE=
# For the example chains file below, these are server-only upstream endpoints.
ZERODEV_ARC_MAINNET_RPC_URL=
# Alternatively configure one chain directly:
LIVESTREAK_AA_CHAIN_ID=5042
LIVESTREAK_AA_RPC_URL=https://rpc.mainnet.arc.io
LIVESTREAK_AA_BUNDLER_URL=
LIVESTREAK_AA_PAYMASTER_URL=
LIVESTREAK_AA_ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# Existing Safe wallet clients still need their chain's Safe module configuration.
LIVESTREAK_AA_SAFE_MODULE=
LIVESTREAK_AA_PAYMASTER_AUTH_TOKEN=

# Arc is the only production chain in this repository. Enable indexing only with verified Arc contracts.
LIVESTREAK_CATALOG_CHAINS=evm
LIVESTREAK_CATALOG_MARKETS=
LIVESTREAK_CRON_DISABLED=0

# Remote gateway registration and signed capability grants.
LIVESTREAK_APP_ORIGIN=https://YOUR_APP_DOMAIN
LIVESTREAK_REMOTE_GATEWAY_TOKEN=
LIVESTREAK_REMOTE_GRANT_KEY=
LIVESTREAK_REMOTE_SESSION_TTL_MS=3600000

# Generic S3-compatible durable media storage. Use an environment-specific bucket.
LIVESTREAK_STORAGE_PROVIDER=s3
LIVESTREAK_STORAGE_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
LIVESTREAK_STORAGE_REGION=auto
LIVESTREAK_STORAGE_BUCKET=livestreak-mainnet-media
LIVESTREAK_STORAGE_ACCESS_KEY_ID=
LIVESTREAK_STORAGE_SECRET_ACCESS_KEY=
LIVESTREAK_STORAGE_PUBLIC_BASE_URL=https://YOUR_MAINNET_PLAYBACK_DOMAIN
LIVESTREAK_HOST_API_TOKEN=
