{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "kit/**/*.ts",
    "chains/evm/index.ts",
    "chains/evm/node.ts",
    "chains/evm/flatten-deployment.ts",
    "chains/evm/addresses-static.ts",
    "chains/evm/addresses.ts",
    "chains/evm/abis-entry.ts",
    "chains/evm/abis.ts",
    "chains/evm/contract.ts",
    "chains/evm/types.ts",
    "chains/evm/generated/abis.ts",
    "chains/evm/deployments/arc-mainnet.ts"
  ],
  "exclude": [
    "chains/evm/lib/**",
    "chains/evm/out/**",
    "chains/evm/cache/**"
  ]
}
