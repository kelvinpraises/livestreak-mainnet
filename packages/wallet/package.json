{
  "name": "@livestreak/wallet",
  "version": "1.0.0-beta.5",
  "description": "Arc ERC-4337 Safe wallet manager and gateway keystore",
  "keywords": [
    "arc",
    "usdc",
    "wallet",
    "erc-4337"
  ],
  "author": "LiveStreak",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#chains/*": {
      "livestreak-dev": "./src/chains/*",
      "default": "./dist/chains/*"
    },
    "#vendor/*": {
      "livestreak-dev": "./src/vendor/*",
      "default": "./dist/vendor/*"
    },
    "#types.js": {
      "livestreak-dev": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "#create-wallet-manager.js": {
      "livestreak-dev": "./src/create-wallet-manager.ts",
      "default": "./dist/create-wallet-manager.js"
    },
    "#index.js": {
      "livestreak-dev": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/vendor",
    "bare.js",
    "patches",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-vendored.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dev": "tsc -w -p tsconfig.build.json"
  },
  "dependencies": {
    "@livestreak/contracts": "file:../contracts",
    "@noble/hashes": "2.2.0",
    "@safe-global/protocol-kit": "^6.1.2",
    "@safe-global/relay-kit": "^4.1.1",
    "@tetherto/wdk-failover-provider": "1.0.0-beta.2",
    "@tetherto/wdk-wallet": "1.0.0-beta.7",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.8",
    "bare-node-runtime": "^1.1.4",
    "bip39": "3.1.0",
    "ethers": "6.14.4",
    "sodium-universal": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "livestreak-dev": "./src/index.ts",
      "bare": "./bare.js",
      "default": "./dist/index.js"
    },
    "./keystore": {
      "types": "./dist/keystore.d.ts",
      "livestreak-dev": "./src/keystore.ts",
      "default": "./dist/keystore.js"
    },
    "./package": {
      "default": "./package.json"
    }
  }
}
